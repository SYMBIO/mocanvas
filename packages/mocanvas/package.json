{
  "name": "@mocanvas/mocanvas",
  "version": "4.1.0",
  "description": "An infinite-canvas SDK for the web: React component, default shapes, tools and UI, on a Rust/WebAssembly engine.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "keywords": [
    "canvas",
    "infinite-canvas",
    "whiteboard",
    "webgl",
    "webassembly",
    "wasm",
    "rust",
    "editor",
    "tldraw",
    "react",
    "sdk",
    "drawing",
    "diagram"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "MIGRATION.md",
    "UI.md"
  ],
  "sideEffects": [
    "*.css",
    "./src/install.ts",
    "./dist/index.js"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mocanvas.css": {
      "style": "./src/ui/ui.css",
      "default": "./src/ui/ui.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./mocanvas.css": {
        "style": "./dist/mocanvas.css",
        "default": "./dist/mocanvas.css"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-docs.mjs ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md MIGRATION.md UI.md && pnpm run build"
  },
  "dependencies": {
    "@mocanvas/editor": "workspace:*",
    "@mocanvas/state": "workspace:*",
    "@mocanvas/store": "workspace:*",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
