{
  "name": "@mocanvas/compat",
  "version": "4.8.6",
  "description": "TL-prefixed aliases over the mocanvas API, for projects migrating an existing tldraw app.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBIO/mocanvas.git",
    "directory": "packages/compat"
  },
  "homepage": "https://mocanvas.symbio.agency",
  "bugs": {
    "url": "https://github.com/SYMBIO/mocanvas/issues"
  },
  "keywords": [
    "tldraw",
    "compat",
    "migration",
    "aliases",
    "mocanvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "compat.css",
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "MIGRATION.md",
    "UI.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compat.css": "./compat.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./compat.css": {
        "style": "./compat.css",
        "default": "./compat.css"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-docs.mjs ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md MIGRATION.md UI.md && pnpm run build"
  },
  "dependencies": {
    "@mocanvas/editor": "workspace:*",
    "@mocanvas/mocanvas": "workspace:*",
    "@mocanvas/state": "workspace:*",
    "@mocanvas/store": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
