{
  "name": "@mocanvas/editor",
  "version": "4.11.2",
  "description": "The mocanvas editor core: Editor, ShapeUtil, StateNode, geometry, bindings and the <Canvas /> renderer.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBIO/mocanvas.git",
    "directory": "packages/editor"
  },
  "homepage": "https://mocanvas.symbio.agency",
  "bugs": {
    "url": "https://github.com/SYMBIO/mocanvas/issues"
  },
  "keywords": [
    "canvas",
    "infinite-canvas",
    "whiteboard",
    "webgl",
    "webassembly",
    "wasm",
    "rust",
    "editor",
    "tldraw"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "FILES.md",
    "MIGRATION.md",
    "SYNC.md",
    "TOOLS.md",
    "UI.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-docs.mjs AGENTS.md ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md FILES.md MIGRATION.md SYNC.md TOOLS.md UI.md && pnpm run build"
  },
  "dependencies": {
    "@mocanvas/state": "workspace:*",
    "@mocanvas/store": "workspace:*",
    "@mocanvas/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@webgpu/types": "^0.1.72",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
