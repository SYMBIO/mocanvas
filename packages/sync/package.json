{
  "name": "@mocanvas/sync",
  "version": "4.8.1",
  "description": "Multiplayer for a mocanvas store: record diffs over a transport, plus presence and cursors.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "keywords": [
    "multiplayer",
    "collaboration",
    "presence",
    "websocket",
    "sync",
    "mocanvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "scripts",
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "MIGRATION.md",
    "UI.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "relay": "node scripts/relay.mjs",
    "prepack": "node ../../scripts/bundle-docs.mjs ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md MIGRATION.md UI.md && pnpm run build"
  },
  "dependencies": {
    "@mocanvas/editor": "workspace:*",
    "@mocanvas/state": "workspace:*",
    "@mocanvas/store": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
