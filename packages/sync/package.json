{
  "name": "@mocanvas/sync",
  "version": "3.0.0",
  "description": "Multiplayer for a mocanvas store: record diffs over a transport, plus presence and cursors.",
  "license": "MIT",
  "author": "Symbio Digital",
  "homepage": "https://github.com/SYMBIO/mocanvas/tree/main/packages/sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBIO/mocanvas.git",
    "directory": "packages/sync"
  },
  "bugs": {
    "url": "https://github.com/SYMBIO/mocanvas/issues"
  },
  "keywords": [
    "multiplayer",
    "collaboration",
    "presence",
    "websocket",
    "sync",
    "mocanvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "scripts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "relay": "node scripts/relay.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@mocanvas/editor": "workspace:*",
    "@mocanvas/state": "workspace:*",
    "@mocanvas/store": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/ws": "^8.5.0",
    "react": "^19.1.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
