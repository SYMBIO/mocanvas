{
  "name": "@mocanvas/store",
  "version": "4.4.0",
  "description": "The mocanvas document model: reactive records, schema, migrations and .tldr file IO.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "keywords": [
    "store",
    "records",
    "crdt",
    "schema",
    "migrations",
    "tldr",
    "mocanvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "MIGRATION.md",
    "UI.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-docs.mjs ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md MIGRATION.md UI.md && pnpm run build"
  },
  "dependencies": {
    "@mocanvas/state": "workspace:*",
    "fractional-indexing": "^3.2.0",
    "nanoid": "^5.1.0"
  }
}
