{
  "name": "@mocanvas/state",
  "version": "4.11.1",
  "description": "Signals for mocanvas: atoms, computed values, transactions and React bindings.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Symbio Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBIO/mocanvas.git",
    "directory": "packages/state"
  },
  "homepage": "https://mocanvas.symbio.agency",
  "bugs": {
    "url": "https://github.com/SYMBIO/mocanvas/issues"
  },
  "keywords": [
    "signals",
    "reactive",
    "state",
    "atom",
    "computed",
    "mocanvas"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARK.md",
    "CLEAN_ROOM.md",
    "COMPAT.md",
    "CUSTOM_SHAPES.md",
    "MIGRATION.md",
    "UI.md"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-docs.mjs ARCHITECTURE.md BENCHMARK.md CLEAN_ROOM.md COMPAT.md CUSTOM_SHAPES.md MIGRATION.md UI.md && pnpm run build"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
